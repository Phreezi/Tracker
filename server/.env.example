# Copia para .env e preenche. Carrega com:  set -a; . ./.env; set +a; npm start
# (ou define estas variáveis no teu serviço de alojamento)

# Palavra-passe do painel web (escolhe uma forte)
ADMIN_PASSWORD=muda-isto-por-favor

# Token partilhado entre o servidor e a app do telemóvel (mín. 16 caracteres).
# Gera um com:  openssl rand -hex 24
DEVICE_TOKEN=cola-aqui-um-token-aleatorio-longo

# Porta do servidor
PORT=8080

# Timezone usada para o horário escolar
TZ_SCHOOL=Europe/Lisbon

# Dias de histórico a manter
RETENTION_DAYS=90
